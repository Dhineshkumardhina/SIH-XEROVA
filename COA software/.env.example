# ==============================================================================
# RAILOPT AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env

# --- Project & Environment ---
APP_NAME=RAILOPT AI
ENVIRONMENT=development
DEMO_MODE=true

# --- Database (PostgreSQL) ---
POSTGRES_USER=railopt_user
POSTGRES_PASSWORD=railopt_password
POSTGRES_DB=railopt_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://railopt_user:railopt_password@postgres:5432/railopt_db

# Local development without Docker (SQLite fallback):
# DATABASE_URL=sqlite:///./railopt_ai.db

# --- Cache & Event Broker (Redis) ---
REDIS_URL=redis://redis:6379/0
# Local development without Docker:
# REDIS_URL=redis://localhost:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET=railopt_ai_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# --- Frontend Environment Variables (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=""
